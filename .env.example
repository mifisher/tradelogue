# ─────────────────────────────────────────────────────────────────────────────
# Tradelogue configuration — copy to .env and fill in.
#   cp .env.example .env
# Nothing here is sent anywhere except the APIs you configure. .env is
# gitignored; keep it that way.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Native Postgres (see README). For `docker compose up -d` instead, use 5433.
DATABASE_URL=postgresql://trader:trader@localhost:5432/tradelogue

# ── Your trading day (required-ish: the defaults assume US Eastern) ──────────
# Every session date, day boundary, and rule time is evaluated in this zone.
# Use an IANA name: America/New_York, America/Los_Angeles, Europe/London…
NEXT_PUBLIC_TRADING_TIMEZONE=America/New_York

# ── Rule thresholds (optional — these are YOUR risk limits) ──────────────────
# Thresholds for the mechanical detectors. The shipped defaults are round
# placeholders, not advice — set them to what you actually trade.
#
# A fresh install seeds ONE sample rule (oversized-outlay). Write your own
# rulebook at /rules, and switch on the other detectors by copying a template
# from DETECTOR_TEMPLATES in src/lib/rules.ts. These values apply to whichever
# rule carries the matching detector, whatever you number it.
#
# oversized-outlay    — max position cost in dollars (contracts × entry × 100)
RULE_OUTLAY_CAP=1000
# reentry-pause       — minutes to wait after a losing exit on the same name
RULE_REENTRY_PAUSE_MIN=10
# circuit-breaker     — stop opening once running day P&L reaches this (negative)
RULE_CIRCUIT_BREAKER=-500
# chop-trade-cap      — max trades to take on an Uncertain / choppy tape
RULE_CHOP_TRADE_CAP=3
# opening-range-entry — entries before this hour (24h, in the timezone above)
#                       are flagged. 10 = the first 30 min of a 09:30 open.
RULE_SESSION_OPEN_HOUR=10

# ── Interactive Brokers Flex Web Service (required to import trades) ─────────
# Client Portal → Performance & Reports → Flex Queries. See README for the
# exact fields to enable — the parser needs specific ones.
IBKR_FLEX_TOKEN=
# Activity Flex Query — end-of-day, the backbone of your history.
IBKR_FLEX_QUERY_ID=
# Trade Confirmation Flex Query — same-day fills, so you can journal intraday.
# The Sync button prefers this; without it, it falls back to the query above.
IBKR_TRADE_CONFIRM_QUERY_ID=

# ── AI provider (optional — every AI feature degrades gracefully without it) ─
# "openrouter" (recommended: one key reaches every model), "moonshot", or
# "anthropic". If omitted, the app picks whichever key is present, in that
# order. Without a key the AI features show an "add your key" guard and the
# rest of the app is unaffected.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Default model for any feature without its own override below.
# `openrouter/free` auto-routes among free models — fine for trying things out,
# but it picks a different model per call, so pin the ones that matter.
OPENROUTER_MODEL=openrouter/free

# Per-feature overrides. See "Choosing your models" in the README for what each
# feature actually demands — they are not interchangeable.
#
# Voice / "Fill with AI" — you watch this fill in, so latency is the whole game.
# Use a FAST, NON-REASONING model. Do not set a reasoning effort on it.
OPENROUTER_VOICE_MODEL=google/gemini-2.5-flash-lite
# Coaching + pattern analysis — quality over speed; ~1-2 min is acceptable.
OPENROUTER_COACH_MODEL=z-ai/glm-5.3-flash
# Market brief — one long structured JSON document; needs a model that holds
# its shape. Most free models mangle it.
OPENROUTER_BRIEF_MODEL=z-ai/glm-5.3-flash
# Chat with your journal — a tool-use loop, so it needs solid function calling.
OPENROUTER_CHAT_MODEL=
# Eval judge — only spent when you run `npm run eval:coaching`. Deliberately a
# DIFFERENT model family from the coach, so nothing grades its own output.
OPENROUTER_JUDGE_MODEL=moonshotai/kimi-k2.6

# ── Alternative providers ────────────────────────────────────────────────────
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
# Also: MOONSHOT_COACH_MODEL / _CHAT_MODEL / _VOICE_MODEL / _JUDGE_MODEL

ANTHROPIC_API_KEY=
# Defaults: claude-opus-4-8 for coach/chat/judge, claude-sonnet-4-6 for voice.
# Also: ANTHROPIC_COACH_MODEL / _CHAT_MODEL / _VOICE_MODEL / _JUDGE_MODEL

# ── Market brief data sources (optional — needed for the brief only) ─────────
# News and Reddit search. Free tier is enough for one brief a day.
TAVILY_API_KEY=
# Quotes and the earnings calendar. Free tier is enough.
FINNHUB_API_KEY=
# Index sparkline history comes from keyless FRED CSVs — nothing to configure.

# ── Misc ─────────────────────────────────────────────────────────────────────
# Tolerance in dollars for `npm run verify:pnl`.
PNL_TOLERANCE=0.01
