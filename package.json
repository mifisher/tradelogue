  "keywords": [
    "trading-journal",
    "trading",
    "options",
    "interactive-brokers",
    "ibkr",
    "ai",
    "llm",
    "nextjs",
    "self-hosted"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
