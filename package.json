    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.8.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
