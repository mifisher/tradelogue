# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local implementation worktrees
/.worktrees/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets. The example template is deliberately committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# User-uploaded chart screenshots (managed at runtime outside public/).
/uploads/

# Eval output (generated by scripts/eval-coaching.ts). Contains your real
# session data and coaching text.
/eval-results/

# Real per-session P&L baseline for scripts/verify-pnl.ts. Real account data —
# kept local only. See "Verifying the P&L engine" in the README.
/data/expected-daily-pnl.json
